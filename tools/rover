#!/usr/bin/env bash
# rover — autoware.rtst_rover 워크스페이스 실험용 CLI
#   rover build [pkg ...]            우리 패키지 오버레이 빌드 (컨테이너, --packages-select). 인자 없으면 전부
#                                    [로버] 없는 것을 먼저 만든다: 플랫폼 라이브러리(platforms/) · 개발 컨테이너 · apt 의존
#   rover psim up [launch_arg ...]   planning_simulator 기동 (RViz 포함). preset 기본 rover — upstream 원본은 planning_module_preset:=default
#   rover psim down | restart        종료 / 재기동 (yaml·xacro 고친 뒤)
#   rover psim logs [-f]             [ERROR]·죽은 프로세스·route 실패만 추림. -f 는 원본 follow
#   rover psim check                 로드된 차량·센서킷 실측 (패키지 경로, TF, 시뮬 파라미터)
#   rover psim watch                 주행 중 0.5 s 마다 한 줄: 시나리오·기어·모드·속도·조향·횡/yaw 오차·검증기 (Ctrl-C 종료)
#   rover shell                      실행 중 컨테이너에 bash (setup.bash 소싱 완료 상태)
#   rover doctor                     새 PC 셋업 점검 (읽기 전용, SETUP.md 절 순서)
#   rover setup [-y]                 점검 + 빠진 것 설치 (단계마다 Y/n, sudo 는 필요한 단계만)
#   rover real up [net=wifi|eth|lo|<인터페이스>] [map=<지도 폴더>] [loc=odom|none] [launch_arg ...]
#                                    [로버] 실차 Autoware 기동 (RViz 없음): Autoware + 오도메트리 측위 + IMU. MANUAL 로 시작 — 바퀴 안 돎
#   rover real down | check | logs [-f]   [로버] 종료 / 상태 실측 / 오류만 추림
#   rover real stop                  [로버] 정지: Autoware 를 STOP 모드로 + 차량 인터페이스를 MANUAL 로
#   rover real rviz net=<인터페이스>  [PC] RViz 만 띄워 로버의 Autoware 에 붙는다 (같은 네트워크)
#   rover carla … | dds …            자리만 (ST-2 때 채움)
# 지도: ROVER_MAP > ~/autoware_data/maps/current(링크, 절대경로 OK) > sample-map-planning. 폴더 위치·깊이 제한 없음
# 환경변수: ROVER_IMAGE  ROVER_MAP(호스트 지도 폴더)  ROVER_HEADLESS=1(rviz 없이)  ROVER_VEHICLE  ROVER_SENSOR
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"  # 심링크(~/.local/bin/rover)로 불러도 fork 루트
# 이미지 = repositories/rtst_rover.pin 의 고정 이미지 (코드 핀과 같은 upstream 릴리스). 플로팅 태그 금지.
. "$ROOT/repositories/rtst_rover.pin"
is_rover() { [ "$(uname -m)" = aarch64 ]; }
if is_rover && [ -n "${PIN_IMAGE_ROVER:-}" ]; then PIN_IMAGE="$PIN_IMAGE_ROVER"; fi   # 로버(arm64)는 같은 릴리스의 로버용 이미지
IMAGE="${ROVER_IMAGE:-$PIN_IMAGE}"
# 지도: ROVER_MAP > ~/autoware_data/maps/current(공용 링크 — 어떤 지도든 여기 걸면 기본) > sample-map-planning
MAP_CURRENT="$HOME/autoware_data/maps/current"
if [ -n "${ROVER_MAP:-}" ]; then MAP_HOST="$ROVER_MAP"
elif [ -e "$MAP_CURRENT" ]; then MAP_HOST="$MAP_CURRENT"
else MAP_HOST="$HOME/autoware_data/maps/sample-map-planning"; fi
VEHICLE="${ROVER_VEHICLE:-rtst_rover}"
SENSOR="${ROVER_SENSOR:-rtst_rover_sensor_kit}"
PSIM=planning_sim
# 기본 = 우리가 고치는 패키지 전부 (autoware_planning_config: 이미지에도 있지만 fork yaml 을 쓰려고 덮어씀)
PKGS_DEFAULT="rtst_rover_description rtst_rover_launch rtst_rover_sensor_kit_description rtst_rover_sensor_kit_launch autoware_planning_config"

B=$'\e[1m'; G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; D=$'\e[2m'; N=$'\e[0m'
ok()  { printf "  ${G}✔${N} %s ${D}%s${N}\n" "$1" "${2:-}"; }
bad() { printf "  ${R}✘${N} %s ${D}%s${N}\n" "$1" "${2:-}"; }
die() { printf "${R}%s${N}\n" "$*" >&2; exit 1; }

# 컨테이너 공통 옵션. 엔트리포인트는 살린다(uid 전달). --entrypoint bash 금지(root 소유 파일 생김).
COMMON=(-e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" -v "$ROOT:/ws" -w /ws)
# ROS 환경: 이미지 underlay → 우리 overlay 순서. 바뀌면 우리 패키지가 가려진다.
SRC='source /opt/autoware/setup.bash; [ -f install/setup.bash ] && source install/setup.bash'

running() { docker ps --format '{{.Names}}' | grep -qx "$PSIM"; }
exists()  { docker ps -a --format '{{.Names}}' | grep -qx "$PSIM"; }

cmd_build() {
  if is_rover; then real_build "$@"; return; fi   # 로버에서는 개발 컨테이너 안에서 빌드 (경로가 다르다)
  local pkgs="${*:-$PKGS_DEFAULT}"
  printf "${B}build${N} %s\n" "$pkgs"
  # --packages-ignore: PC 는 로버 드라이버 패키지를 빌드하지 않는다. 그 소스가 src/ 에 있으면(rover.repos 를 import 한 경우)
  # rtst_rover_launch 의 exec_depend 를 따라 colcon 이 빌드된 install 을 요구해 실패한다 [실측 PC 2026-11-19] → 없는 것으로 보게 한다
  docker run --rm "${COMMON[@]}" "$IMAGE" bash -c "
    source /opt/autoware/setup.bash
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release --packages-select $pkgs --packages-ignore $PKGS_ROVER 2>&1 \
      | grep -v -e '^\[entrypoint\]' -e 'haven.t been built' -e '^- ' -e 'being used from' -e 'packages-ignore' -e 'suppress this warning' -e 'ignoring unknown package'"
  printf "  install/ 오버레이 패키지: "; ls "$ROOT/install" | grep -v -e "^_" -e "^COLCON" -e "setup\." | paste -sd' '; echo
}

psim_up() {
  [ -d "$MAP_HOST" ] || die "지도 없음: $MAP_HOST (ROVER_MAP 로 지정)"
  [ -d "$ROOT/install" ] || die "install/ 없음 — 먼저 rover build"
  exists && docker rm -f "$PSIM" >/dev/null
  local rviz=true; [ "${ROVER_HEADLESS:-0}" = 1 ] && rviz=false
  # 플래닝 preset 기본 = rover (config/preset/rover_preset.yaml). upstream 원본은 planning_module_preset:=default 로
  # 지도 폴더를 실제 경로로 풀어 그 폴더만 마운트 → 링크(절대경로)·깊은 폴더 모두 됨. ⚠ 폴더 안 파일이 폴더 밖을 가리키는 링크면 컨테이너에서 깨짐
  local map_real map_name; map_real="$(readlink -f "$MAP_HOST")"; map_name="$(basename "$map_real")"
  local extra="$*"
  case " $extra " in *" planning_module_preset:="*) ;; *) extra="planning_module_preset:=rover${extra:+ $extra}";; esac
  # --cap-add=NET_ADMIN: 엔트리포인트가 호스트 lo 에 multicast 를 켠다(없으면 CycloneDDS 참여자 인덱스 고갈로 노드 25개 즉사)
  docker run -d --name "$PSIM" --network host --gpus all --cap-add=NET_ADMIN \
    "${COMMON[@]}" \
    -e DISPLAY="${DISPLAY:-:0}" -e QT_X11_NO_MITSHM=1 -v /tmp/.X11-unix:/tmp/.X11-unix:rw \
    -v "$map_real":/autoware_data/maps/$map_name:ro \
    "$IMAGE" bash -c "$SRC
      ros2 launch autoware_launch planning_simulator.launch.xml \
        map_path:=/autoware_data/maps/$map_name \
        vehicle_model:=$VEHICLE sensor_model:=$SENSOR vehicle_id:=$VEHICLE rviz:=$rviz $extra" >/dev/null
  printf "${B}psim up${N} vehicle_model=%s sensor_model=%s map=%s rviz=%s %s\n" "$VEHICLE" "$SENSOR" "$map_name ($map_real)" "$rviz" "$extra"
  local i=0
  while [ $i -lt 40 ]; do
    sleep 2; i=$((i+1))
    running || { bad "컨테이너 종료됨" "rover psim logs -f 로 확인"; return 1; }
    if docker logs "$PSIM" 2>&1 | grep -q "\[rviz2-[0-9]*\]: process started\|rviz2.*Stereo is\|simple_planning_simulator.*process started"; then break; fi
  done
  sleep 8
  local died; died="$(docker logs "$PSIM" 2>&1 | { grep -o '\[ERROR\] \[[^]]*\]: process has died' || true; } | sort -u | wc -l)"  # grep 무결과(=정상)가 pipefail 로 스크립트를 죽이지 않게
  if [ "$died" = 0 ]; then ok "노드 전부 생존" "$(docker exec "$PSIM" bash -c "$SRC; ros2 node list 2>/dev/null | wc -l") 노드"
  else bad "죽은 프로세스 ${died}종" "rover psim logs"; fi
  echo "  다음: RViz 2D Pose Estimate → 2D Goal Pose(같은 차선·진행 방향) → AUTO"
}
psim_down() { exists && { docker rm -f "$PSIM" >/dev/null; ok "psim 종료"; } || printf "  ${D}·${N} psim 미실행\n"; }
psim_logs() {
  exists || die "psim 미실행"
  if [ "${1:-}" = -f ]; then docker logs -f "$PSIM"; return; fi
  docker logs "$PSIM" 2>&1 | grep -n "\[ERROR\]\|process has died\|Failed to plan\|Failed to find a proper route\|start lane ids\|goal lane id\|Setting goal pose\|Setting estimate pose" \
    | grep -v "Mode path not found\|has not received. Set ERROR\|VehicleCmdFilter" | cut -c1-200 | tail -40 || true
}
psim_check() {
  running || die "psim 미실행"
  docker exec "$PSIM" bash -c "$SRC
    echo '--- robot_description 패키지 경로:'; ros2 param get /robot_state_publisher robot_description 2>/dev/null | grep -o 'package://[a-z_0-9]*/' | sort -u | sed 's/^/  /'
    echo '--- 차량 mesh:'; ros2 param get /robot_state_publisher robot_description 2>/dev/null | grep -o 'package://rtst_rover_description/[^\\\"]*' | sed 's/^/  /'
    echo '--- TF base_link → 센서 (xyz):'
    for f in sensor_kit_base_link lidar_frame imu_link camera_link rs_helios_top; do
      printf '  %-22s ' \$f; timeout 4 ros2 run tf2_ros tf2_echo base_link \$f 2>&1 | grep -m1 Translation || echo '(없음)'; done
    echo '--- simple_planning_simulator 가 받은 값:'
    for p in vehicle_model_type wheel_base wheel_tread max_steer_angle vel_lim steer_lim acc_time_delay steer_time_delay; do
      printf '  %-18s ' \$p; ros2 param get /simulation/simple_planning_simulator \$p 2>/dev/null | sed 's/.*value is: //' || echo '?'; done
    echo '--- 플래닝 (autoware_planning_config/config/scenario_planning/common/common.param.yaml → velocity_smoother):'
    printf '  config 패키지 출처  '; ros2 pkg prefix autoware_planning_config 2>/dev/null | sed 's|/opt/autoware/.*|& (이미지 사본 — fork yaml 미반영)|; s|/ws/install/.*|& (우리 오버레이 — fork yaml 반영)|'
    for p in max_vel normal.max_acc normal.min_acc normal.max_jerk; do
      printf '  %-18s ' \$p; ros2 param get /planning/scenario_planning/velocity_smoother \$p 2>/dev/null | sed 's/.*value is: //' || echo '?'; done
    echo '--- 상태:'
    printf '  노드 수 '; ros2 node list 2>/dev/null | wc -l
    printf '  scenario '; timeout 3 ros2 topic echo /planning/scenario_planning/scenario --once --field current_scenario 2>/dev/null | head -1 || echo '?'
    printf '  routing  state='; timeout 3 ros2 topic echo /api/routing/state --once --field state 2>/dev/null | head -1 | tr -d '\n'; echo '  (1 UNSET, 2 SET, 3 ARRIVED, 4 CHANGING)'
    printf '  op mode  '; timeout 3 ros2 topic echo /api/operation_mode/state --once 2>/dev/null | grep -E '^mode|is_autonomous_mode_available' | paste -sd' ' || echo '?'
    printf '  ego xy   '; timeout 3 ros2 topic echo /localization/kinematic_state --once --field pose.pose.position 2>/dev/null | head -2 | paste -sd' ' || echo '(초기 위치 전)'
  " 2>&1 | grep -v '^\[entrypoint\]'
}
cmd_psim() {
  case "${1:-}" in
    up) shift; psim_up "$@";; down) psim_down;; restart) psim_down; shift; psim_up "$@";;
    logs) shift; psim_logs "$@";; check) psim_check;;
    watch) running || die "psim 미실행"; docker exec -it "$PSIM" bash -c "$SRC; exec python3 /ws/tools/psim_watch.py";;
    goal|pose|auto) die "psim $1: 아직 없음 (RViz 없이 초기위치·goal·AUTO — 회귀 테스트 때 추가)";;
    *) die "rover psim up|down|restart|logs [-f]|check|watch";;
  esac
}
cmd_shell() { running || die "psim 미실행 — rover psim up"; docker exec -it "$PSIM" bash -c "$SRC; exec bash"; }

# ── 실차 ────────────────────────────────────────────────────────────────────────────────────
# 로버에서는 개발 컨테이너 하나를 계속 쓴다: 드라이버가 쓰는 apt 패키지(robot_localization, imu_filter_madgwick,
# laser_filters — rosdep install 로 설치)가 이미지에는 없고 그 컨테이너에만 있다. 우리 이미지를 만들면 psim 처럼 docker run 으로 바꾼다.
#   컨테이너를 만드는 것은 rover build 뿐이다 (dev_create). 다른 명령은 없으면 "먼저 rover build" 라고 하고 멈춘다.
DEV=rtst_rover_dev
DEV_WS=/home/aw/autoware                 # 컨테이너 안 워크스페이스 경로. 빌드 산출물의 절대 경로가 이 기준이라 /ws 로 못 바꾼다
DEV_MAPS=/home/aw/autoware_data/maps     # 지도는 마운트가 아니라 복사해 넣는다 (컨테이너가 지도 마운트 없이 만들어짐)
DEV_MODELS=/home/aw/autoware_data/ml_models   # 인지 모델(.onnx)과 엔진(.engine) — 호스트 ~/autoware_data/ml_models 를 마운트
DEV_DDS=/tmp/rover_cyclonedds.xml        # real up 이 만드는 DDS 설정. real 의 다른 명령도 전부 이 설정으로 실행
DEV_DEPS_MARK=/opt/.rover_deps_done      # rosdep install 을 끝낸 컨테이너라는 표시 (컨테이너 안)
DEV_SRC=""                               # 컨테이너 안 ROS 환경 — platform_load 가 채운다
PKGS_ROVER="ros_robot_controller_msgs ros_robot_controller controller rtst_rover_base_bringup rtst_rover_vehicle_interface rtst_rover_odometry_localizer sclidar_ros2 imu_calib deptrum-ros-driver-aurora930 rtst_rover_sensor_bringup"
RVIZ=rover_rviz

# 플랫폼(보드 + OS 판)마다 다른 GPU 구성은 platforms/<이름>/ 에 있다. 지금 기계에 맞는 것을 골라 값을 읽는다.
PLATFORM_NAME=""
platform_load() {
  [ -z "$PLATFORM_NAME" ] || return 0
  local name; name="$(bash "$ROOT/platforms/detect.sh")" || exit 1
  PLATFORM_DIR="$ROOT/platforms/$name"
  # shellcheck source=/dev/null
  . "$PLATFORM_DIR/platform.env"
  PLATFORM_OVERLAY_SO="$PLATFORM_HOST_DIR/ws/install/autoware_tensorrt_common/lib/libautoware_tensorrt_common.so"
  # 순서: 이미지의 Autoware → 우리 패키지 → 플랫폼 오버레이(다시 빌드한 Autoware 패키지가 이미지 것을 가린다)
  #       → 라이브러리 경로 맨 앞에 호환 드라이버 · 얹은 TensorRT
  DEV_SRC="cd $DEV_WS && source /opt/autoware/setup.bash && source install/setup.bash && source $PLATFORM_MOUNT/ws/install/setup.bash && export LD_LIBRARY_PATH=$PLATFORM_LD_PREPEND:\$LD_LIBRARY_PATH"
}

dev_exists()   { docker ps -a --format '{{.Names}}' | grep -qx "$DEV"; }
dev_running()  { docker ps --format '{{.Names}}' | grep -qx "$DEV"; }
# 컨테이너가 지금 pin 이미지로 만든 것인가 (pin 을 바꾼 뒤 옛 컨테이너를 그대로 쓰는 것을 막는다)
dev_image_ok() { [ "$(docker inspect -f '{{.Image}}' "$DEV")" = "$(docker image inspect -f '{{.Id}}' "$IMAGE" 2>/dev/null)" ]; }
dev_image_die() { die "컨테이너 $DEV 가 pin 이미지($IMAGE)로 만든 것이 아니다: $(docker inspect -f '{{.Config.Image}}' "$DEV")
  옛 컨테이너를 남기려면  docker rename $DEV ${DEV}_old   (버리려면 docker rm $DEV)  → 그 뒤 rover build"; }

dev_ready() {
  is_rover || die "이 명령은 로버(arm64)에서만: rover real $1"
  platform_load
  dev_exists || die "개발 컨테이너 $DEV 없음 — 먼저 rover build (컨테이너를 만들고 빌드까지 한다)"
  dev_image_ok || dev_image_die
  [ -f "$PLATFORM_OVERLAY_SO" ] || die "플랫폼($PLATFORM_NAME) 오버레이 없음 — 먼저 rover build"
  [ -f "$ROOT/install/setup.bash" ] || die "install/ 없음 — 먼저 rover build"
  dev_running || { docker start "$DEV" >/dev/null; sleep 2; ok "컨테이너 $DEV 시작"; }
}

# 개발 컨테이너를 pin 이미지로 만든다 (rover build 만 부른다).
#   GPU 옵션 · 플랫폼 폴더 마운트 = platforms/<이름>/platform.env,  장치 = MCU 보드(/dev/rrc) · 2D 라이다(/dev/lidar) · USB 전체(카메라)
dev_create() {
  local rrc lidar
  rrc="$(readlink -f /dev/rrc 2>/dev/null || true)"; lidar="$(readlink -f /dev/lidar 2>/dev/null || true)"
  [ -c "$rrc" ]   || die "/dev/rrc 없음 — 컨테이너를 만들 때는 MCU 보드 USB 가 꽂혀 있어야 한다 (장치를 컨테이너에 넘긴다)"
  [ -c "$lidar" ] || die "/dev/lidar 없음 — 컨테이너를 만들 때는 2D 라이다 USB 가 꽂혀 있어야 한다"
  docker image inspect "$IMAGE" >/dev/null 2>&1 || die "이미지 없음: $IMAGE — docker pull $IMAGE"
  mkdir -p "$HOME/autoware_data/ml_models"
  # --cap-add=NET_ADMIN: 엔트리포인트가 lo 에 multicast 를 켠다.  c 189:* = USB 장치(뎁스 카메라)
  # shellcheck disable=SC2086
  docker run -d --name "$DEV" --network host --cap-add=NET_ADMIN $PLATFORM_DOCKER_GPU_ARGS \
    -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" -v "$ROOT:$DEV_WS" -w "$DEV_WS" \
    -v "$PLATFORM_HOST_DIR:$PLATFORM_MOUNT:ro" -v "$HOME/autoware_data/ml_models:$DEV_MODELS" \
    -v /dev/bus/usb:/dev/bus/usb --device-cgroup-rule 'c 189:* rmw' \
    --device "$rrc:/dev/rrc" --device "$lidar:/dev/lidar" \
    "$IMAGE" sleep infinity >/dev/null
  ok "컨테이너 $DEV 만듦" "$IMAGE, 플랫폼 $PLATFORM_NAME"
}

# 드라이버 패키지가 package.xml 에 적어 둔 apt 의존을 컨테이너에 설치한다 (한 번). 이미지에 없는 것만 깔린다.
dev_deps() {
  docker exec "$DEV" test -f "$DEV_DEPS_MARK" && return 0
  printf "  apt 의존 설치 (rosdep install — 처음 한 번, 몇 분)\n"
  docker exec "$DEV" /docker-entrypoint.sh bash -c "set -e
    cd $DEV_WS && source /opt/autoware/setup.bash
    sudo apt-get update -qq
    rosdep update --rosdistro \$ROS_DISTRO >/dev/null
    rosdep install --from-paths src/vehicle/external src/sensor_component/external --ignore-src -y -r --rosdistro \$ROS_DISTRO
    sudo touch $DEV_DEPS_MARK" 2>&1 | grep -v '^\[entrypoint\]' | grep -E '^(ERROR|E:|executing command|#All required)|Setting up ros-' | sed 's/^/    /' || true
  docker exec "$DEV" test -f "$DEV_DEPS_MARK" || die "rosdep install 실패 — docker exec -it $DEV /docker-entrypoint.sh bash 로 들어가 직접 돌려 본다"
}
# 컨테이너 안에서 실행 (real up 이 정한 DDS 설정으로). dev_bg 는 백그라운드
dev_exec() { docker exec -e CYCLONEDDS_URI="file://$DEV_DDS" "$DEV" /docker-entrypoint.sh bash -c "$DEV_SRC; $1" 2>&1 | grep -v '^\[entrypoint\]' || true; }
dev_bg()   { docker exec -d -e CYCLONEDDS_URI="file://$DEV_DDS" "$DEV" /docker-entrypoint.sh bash -c "$DEV_SRC && $1"; }
real_running() { docker exec "$DEV" pgrep -f "[r]os2 launch autoware_launch" >/dev/null 2>&1; }
# net=wifi|eth 를 로버의 인터페이스 이름으로. 그 밖의 값은 인터페이스 이름 그대로
net_if() { case "$1" in wifi) echo wlP1p1s0;; eth) echo enP8p1s0;; *) echo "$1";; esac; }
# 인터페이스 하나에 묶은 cyclonedds 설정 파일을 만든다 (틀 = docker/files/cyclonedds.xml, lo 자리만 바꿈)
dds_file() {
  local ifname="$1" out="$2"
  # IP 가 없는 인터페이스(케이블 빠짐 등)에 묶으면 DDS 가 노드를 못 만든다
  [ "$ifname" = lo ] || ip -4 -o addr show dev "$ifname" 2>/dev/null | grep -q inet || die "인터페이스 $ifname 없음 또는 IP 없음 (ip -br addr 로 확인)"
  sed "s|<NetworkInterface name=\"lo\"|<NetworkInterface name=\"$ifname\"|" "$ROOT/docker/files/cyclonedds.xml" > "$out"
  grep -q "NetworkInterface name=\"$ifname\"" "$out" || die "DDS 설정 생성 실패: $out"
}

# 로버의 rover build = 없는 것을 전부 만든다: ① 플랫폼 라이브러리·오버레이 ② 개발 컨테이너(+apt 의존) ③ 우리 패키지
real_build() {
  platform_load
  local pkgs="${*:-$PKGS_DEFAULT $PKGS_ROVER}" img_id stamp="$ROOT/build/.rover_image"
  # ① 플랫폼: NVIDIA 라이브러리 받기(fetch) + Autoware 패키지 일부 다시 빌드(build). 이미 있으면 건너뛴다
  if [ ! -f "$PLATFORM_OVERLAY_SO" ]; then
    printf "${B}platform${N} %s — 처음 한 번 (받기 약 2.3 GB)\n" "$PLATFORM_NAME"
    bash "$PLATFORM_DIR/fetch.sh"; bash "$PLATFORM_DIR/build.sh"
  fi
  # ② 컨테이너
  if dev_exists; then dev_image_ok || dev_image_die; else dev_create; fi
  dev_running || { docker start "$DEV" >/dev/null; sleep 2; ok "컨테이너 $DEV 시작"; }
  dev_deps
  # ③ 우리 패키지. build/ 는 만든 이미지에 묶인다(컴파일러 경로가 CMake 캐시에 남는다) → 다른 이미지의 것이면 멈춘다
  img_id="$(docker image inspect -f '{{.Id}}' "$IMAGE")"
  if [ -d "$ROOT/build" ] && [ "$(cat "$stamp" 2>/dev/null)" != "$img_id" ]; then
    die "build/ 가 지금 이미지로 만든 것이 아니다 — $ROOT 의 build/ install/ log/ 를 지우거나 다른 이름으로 옮긴 뒤 다시 rover build"
  fi
  printf "${B}build${N} (컨테이너 %s) %s\n" "$DEV" "$pkgs"
  docker exec "$DEV" /docker-entrypoint.sh bash -c "set -o pipefail
    cd $DEV_WS && source /opt/autoware/setup.bash; [ -f install/setup.bash ] && source install/setup.bash
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release --packages-select $pkgs 2>&1 \
      | grep -v -e '^\[entrypoint\]' -e 'haven.t been built' -e '^- ' -e 'being used from' -e 'packages-ignore' -e 'suppress this warning'" \
    || die "빌드 실패"
  echo "$img_id" > "$stamp"
}

real_up() {
  dev_ready up
  local net=wifi map="$MAP_HOST" loc=odom extra="" a
  for a in "$@"; do case "$a" in
    net=*) net="${a#net=}";; map=*) map="${a#map=}";; loc=*) loc="${a#loc=}";;
    *:=*) extra="$extra $a";; *) die "모르는 인자: $a  (net= map= loc= 또는 launch 인자 이름:=값)";; esac; done
  case "$loc" in odom|none) ;; *) die "loc=odom|none";; esac
  real_running && die "이미 떠 있음 — rover real down 먼저"
  [ -d "$map" ] || die "지도 없음: $map (map=<폴더> 또는 ROVER_MAP)"
  [ -e /dev/rrc ] || die "/dev/rrc 없음 — MCU 보드 USB 확인"
  local ifname map_real map_name tmp
  ifname="$(net_if "$net")"; map_real="$(readlink -f "$map")"; map_name="$(basename "$map_real")"
  # DDS 설정을 컨테이너에 넣는다
  tmp="$(mktemp)"; dds_file "$ifname" "$tmp"; docker cp -q "$tmp" "$DEV:$DEV_DDS"; rm -f "$tmp"
  docker exec "$DEV" chmod 644 "$DEV_DDS"
  # 지도는 매번 다시 복사 (호스트에서 고친 lanelet 이 반영되게)
  docker exec "$DEV" bash -c "mkdir -p $DEV_MAPS && rm -rf $DEV_MAPS/$map_name"
  docker cp -q "$map_real" "$DEV:$DEV_MAPS/$map_name"
  docker exec "$DEV" pkill -f "ros2cli.daemon" 2>/dev/null || true   # 옛 DDS 설정을 쥔 ros2 데몬 제거
  case " $extra " in *" planning_module_preset:="*) ;; *) extra="planning_module_preset:=rover$extra";; esac
  # psim launch 에서 시뮬레이션 차만 뺀 구성:
  #   vehicle_simulation:=false → 우리 vehicle_interface.launch.xml 이 불린다, launch_dummy_vehicle:=false → simple_planning_simulator 끔
  dev_bg "ros2 launch autoware_launch planning_simulator.launch.xml map_path:=$DEV_MAPS/$map_name \
      vehicle_model:=$VEHICLE sensor_model:=$SENSOR vehicle_id:=$VEHICLE rviz:=false \
      vehicle_simulation:=false launch_dummy_vehicle:=false $extra > /tmp/real_autoware.log 2>&1"
  # IMU 후처리(/imu): 로버 EKF 가 쓴다. 센서킷 런치로 옮기기 전까지 따로 띄운다
  dev_bg "ros2 launch rtst_rover_sensor_bringup imu.launch.xml > /tmp/real_imu.log 2>&1"
  # 임시 측위: 초기 위치 + 로버 odom → /localization/kinematic_state, TF map→base_link
  [ "$loc" = odom ] && dev_bg "ros2 launch rtst_rover_odometry_localizer rtst_rover_odometry_localizer.launch.xml > /tmp/real_localizer.log 2>&1"
  printf "${B}real up${N} net=%s(%s) map=%s loc=%s %s\n" "$net" "$ifname" "$map_name" "$loc" "$extra"
  printf "  기동 대기 (Jetson 에서 약 2분) "
  # 시작된 프로세스 수가 18초 동안 그대로면 다 뜬 것으로 본다
  local i=0 n=0 last=-1 same=0
  while [ $i -lt 90 ]; do
    sleep 3; i=$((i+1)); printf "."
    n="$(docker exec "$DEV" grep -c "process started" /tmp/real_autoware.log 2>/dev/null || true)"
    if [ "${n:-0}" -ge 50 ] && [ "$n" = "$last" ]; then same=$((same+1)); else same=0; fi
    last="$n"; [ $same -ge 6 ] && break
    if [ $i -ge 4 ] && ! real_running; then break; fi   # launch 가 일찍 죽으면 기다리지 않는다
  done; echo
  local died; died="$(docker exec "$DEV" grep -c "process has died" /tmp/real_autoware.log 2>/dev/null || true)"
  real_running || { bad "Autoware launch 가 종료됨" "rover real logs"; return 1; }
  if [ "${died:-0}" = 0 ]; then ok "프로세스 ${n}개 시작, 죽은 것 없음"; else bad "죽은 프로세스 ${died}개" "rover real logs"; fi
  echo "  제어 모드는 MANUAL 로 시작 — AUTO 를 걸기 전에는 바퀴로 아무것도 안 간다"
  echo "  다음: rover real check  ·  PC 에서 rover real rviz net=<PC 인터페이스>  ·  멈출 때 rover real stop / down"
}

real_down() {
  dev_ready down
  docker exec "$DEV" bash -c '
    for p in $(pgrep -f "[r]os2 launch"); do kill -INT $p; done
    for i in $(seq 25); do pgrep -f "[r]os2 launch" >/dev/null || break; sleep 1; done
    # SIGINT 로 안 죽고 남는 것까지 정리. 주의: 이 스크립트 본문에 아래 패턴과 맞는 글자를 쓰면 자기 자신이 죽는다 (그래서 첫 글자를 [] 로 감쌈)
    pgrep -f "[r]os2 launch|[c]omponent_container|[o]dom_publisher|[r]os_robot_controller/lib|[e]kf_node|[i]mu_filter|[a]pply_calib|[o]dometry_localizer_node|[v]ehicle_interface_node" | xargs -r kill -9
    sleep 1
    echo "남은 ROS 프로세스: $(ps -eo cmd | grep -E "^/opt/(ros|autoware)/|/home/aw/autoware/[i]nstall/" | grep -vc "ros2cli.daemon")"' | sed 's/^/  /'
  ok "real 종료"
}

real_check() {
  dev_ready check; real_running || die "real 미실행 — rover real up"
  dev_exec '
    printf "  노드 수                               "; ros2 node list --no-daemon --spin-time 6 2>/dev/null | wc -l
    printf "  죽은 프로세스                         "; grep -c "process has died" /tmp/real_autoware.log || true
    printf "  DDS 인터페이스                        "; grep -o "NetworkInterface name=\"[^\"]*\"" '"$DEV_DDS"'
    for t in /odom /vehicle/status/velocity_status /localization/kinematic_state /control/command/control_cmd; do
      printf "  %-37s " $t; timeout 6 ros2 topic hz $t 2>&1 | grep "average rate" | tail -1 | grep . || echo "(안 나옴)"; done
    printf "  제어 모드 (1 AUTONOMOUS, 4 MANUAL)    "; timeout 4 ros2 topic echo --once /vehicle/status/control_mode --field mode 2>/dev/null | head -1 | grep . || echo "?"
    printf "  측위 초기화 (1 미완, 3 완료)          "; timeout 4 ros2 topic echo --once /api/localization/initialization_state --field state 2>/dev/null | head -1 | grep . || echo "?"
    printf "  경로 (1 없음, 2 설정됨, 3 도착)       "; timeout 4 ros2 topic echo --once /api/routing/state --field state 2>/dev/null | head -1 | grep . || echo "?"
    printf "  AUTO 가능                             "; timeout 4 ros2 topic echo --once /system/operation_mode/availability --field autonomous 2>/dev/null | head -1 | grep . || echo "?"
    printf "  위치 xy                               "; timeout 4 ros2 topic echo --once /localization/kinematic_state --field pose.pose.position 2>/dev/null | head -2 | paste -sd" " | grep . || echo "(초기 위치 전)"
  '
}

real_stop() {
  dev_ready stop; real_running || die "real 미실행"
  dev_exec '
    timeout 10 ros2 service call /api/operation_mode/change_to_stop autoware_adapi_v1_msgs/srv/ChangeOperationMode "{}" 2>&1 | grep -o "success=[A-Za-z]*" | sed "s/^/  Autoware STOP 모드: /"
    timeout 10 ros2 service call /control/control_mode_request autoware_vehicle_msgs/srv/ControlModeCommand "{mode: 4}" 2>&1 | grep -o "success=[A-Za-z]*" | sed "s/^/  차량 인터페이스 MANUAL: /"'
}

real_logs() {
  dev_ready logs
  if [ "${1:-}" = -f ]; then docker exec -it "$DEV" tail -f /tmp/real_autoware.log /tmp/real_localizer.log; return; fi
  docker exec "$DEV" bash -c 'grep -n "\[ERROR\]\|process has died\|Traceback\|Failed to plan\|Failed to find a proper route" /tmp/real_autoware.log /tmp/real_localizer.log /tmp/real_imu.log 2>/dev/null \
    | grep -v "Mode path not found\|has not received. Set ERROR\|VehicleCmdFilter" | cut -c1-220 | tail -40' || true
}

# PC: RViz 만. 로버와 같은 네트워크의 인터페이스에 DDS 를 묶는다
real_rviz() {
  is_rover && die "rover real rviz 는 PC 에서"
  local net="" a
  for a in "$@"; do case "$a" in net=*) net="${a#net=}";; *) die "rover real rviz net=<인터페이스>  (ip -br addr 로 확인)";; esac; done
  [ -n "$net" ] || die "rover real rviz net=<인터페이스>  (로버와 같은 대역의 PC 인터페이스. ip -br addr 로 확인)"
  [ -d "$ROOT/install" ] || die "install/ 없음 — 먼저 rover build (로버 모델 mesh 가 필요)"
  local dds="/tmp/rover_cyclonedds_$net.xml"; dds_file "$net" "$dds"
  docker ps -a --format '{{.Names}}' | grep -qx "$RVIZ" && docker rm -f "$RVIZ" >/dev/null
  docker run -d --name "$RVIZ" --network host --gpus all --cap-add=NET_ADMIN \
    "${COMMON[@]}" \
    -e DISPLAY="${DISPLAY:-:0}" -e QT_X11_NO_MITSHM=1 -v /tmp/.X11-unix:/tmp/.X11-unix:rw \
    -v "$dds":/tmp/rover_cyclonedds.xml:ro -e CYCLONEDDS_URI=file:///tmp/rover_cyclonedds.xml \
    "$IMAGE" bash -c "$SRC
      rviz2 -d \$(ros2 pkg prefix autoware_launch)/share/autoware_launch/rviz/autoware.rviz" >/dev/null
  printf "${B}real rviz${N} net=%s  (컨테이너 %s, 끄기: docker rm -f %s)\n" "$net" "$RVIZ" "$RVIZ"
  echo "  로버에서 rover real up 이 떠 있어야 지도·로버가 보인다. 안 보이면: docker logs $RVIZ"
}

cmd_real() {
  case "${1:-}" in
    up) shift; real_up "$@";; down) real_down;; check) real_check;; stop) real_stop;;
    logs) shift; real_logs "$@";; rviz) shift; real_rviz "$@";;
    *) die "rover real up [net=wifi|eth|lo] [map=<폴더>] [loc=odom|none] | down | check | stop | logs [-f] | rviz net=<인터페이스>";;
  esac
}

# 🔒 버전 잠금: 코드·pin·이미지가 어긋나면 실행 안 함 (tools/version_gate.sh, 해결은 rover doctor)
gate() { bash "$ROOT/tools/version_gate.sh" || exit 1; }

case "${1:-}" in
  build) gate;;
  psim) case "${2:-}" in up|restart|watch) gate;; esac;;
  shell) gate;;
  real) case "${2:-}" in up|rviz) gate;; esac;;
esac

case "${1:-}" in
  build) shift; cmd_build "$@";;
  psim)  shift; cmd_psim "$@";;
  shell) cmd_shell;;
  doctor) shift; exec bash "$ROOT/tools/doctor.sh" "$@";;
  setup)  shift; exec bash "$ROOT/tools/doctor.sh" --fix "$@";;
  real)  shift; cmd_real "$@";;
  carla|dds) die "rover $1: 아직 없음 (ST-2 때 채움)";;
  *) sed -n '2,18p' "$0";;
esac
