#!/usr/bin/env bash
# rover — autoware.rtst_rover 워크스페이스 실험용 CLI
#   rover build [pkg ...]            우리 패키지 오버레이 빌드 (컨테이너, --packages-select)
#   rover psim up [launch_arg ...]   planning_simulator 기동 (RViz 포함). 예: rover psim up vehicle_model:=rtst_rover
#   rover psim down | restart        종료 / 재기동 (yaml·xacro 고친 뒤)
#   rover psim logs [-f]             [ERROR]·죽은 프로세스·route 실패만 추림. -f 는 원본 follow
#   rover psim check                 로드된 차량·센서킷 실측 (패키지 경로, TF, 시뮬 파라미터)
#   rover shell                      실행 중 컨테이너에 bash (setup.bash 소싱 완료 상태)
#   rover carla … | real … | dds …   자리만 (ST-2 / 실차 때 채움)
# 환경변수: ROVER_IMAGE  ROVER_MAP(호스트 지도 폴더)  ROVER_HEADLESS=1(rviz 없이)  ROVER_VEHICLE  ROVER_SENSOR
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"  # 심링크(~/.local/bin/rover)로 불러도 fork 루트
IMAGE="${ROVER_IMAGE:-ghcr.io/autowarefoundation/autoware:universe-cuda-jazzy}"
MAP_HOST="${ROVER_MAP:-$HOME/autoware_data/maps/sample-map-planning}"
VEHICLE="${ROVER_VEHICLE:-rtst_rover}"
SENSOR="${ROVER_SENSOR:-rtst_rover_sensor_kit}"
PSIM=planning_sim
PKGS_DEFAULT="rtst_rover_description rtst_rover_launch rtst_rover_sensor_kit_description rtst_rover_sensor_kit_launch"

B=$'\e[1m'; G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; D=$'\e[2m'; N=$'\e[0m'
ok()  { printf "  ${G}✔${N} %s ${D}%s${N}\n" "$1" "${2:-}"; }
bad() { printf "  ${R}✘${N} %s ${D}%s${N}\n" "$1" "${2:-}"; }
die() { printf "${R}%s${N}\n" "$*" >&2; exit 1; }

# 컨테이너 공통 옵션. 엔트리포인트는 살린다(uid 전달). --entrypoint bash 금지(root 소유 파일 생김).
COMMON=(-e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" -v "$ROOT:/ws" -w /ws)
# ROS 환경: 이미지 underlay → 우리 overlay 순서. 바뀌면 우리 패키지가 가려진다.
SRC='source /opt/autoware/setup.bash; [ -f install/setup.bash ] && source install/setup.bash'

running() { docker ps --format '{{.Names}}' | grep -qx "$PSIM"; }
exists()  { docker ps -a --format '{{.Names}}' | grep -qx "$PSIM"; }

cmd_build() {
  local pkgs="${*:-$PKGS_DEFAULT}"
  printf "${B}build${N} %s\n" "$pkgs"
  docker run --rm "${COMMON[@]}" "$IMAGE" bash -c "
    source /opt/autoware/setup.bash
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release --packages-select $pkgs 2>&1 \
      | grep -v -e '^\[entrypoint\]' -e 'haven.t been built' -e '^- ' -e 'being used from' -e 'packages-ignore' -e 'suppress this warning'"
  printf "  install/ 오버레이 패키지: "; ls "$ROOT/install" | grep -v -e "^_" -e "^COLCON" -e "setup\." | paste -sd' '; echo
}

psim_up() {
  [ -d "$MAP_HOST" ] || die "지도 없음: $MAP_HOST (ROVER_MAP 로 지정)"
  [ -d "$ROOT/install" ] || die "install/ 없음 — 먼저 rover build"
  exists && docker rm -f "$PSIM" >/dev/null
  local rviz=true; [ "${ROVER_HEADLESS:-0}" = 1 ] && rviz=false
  local extra="$*"
  # --cap-add=NET_ADMIN: 엔트리포인트가 호스트 lo 에 multicast 를 켠다(없으면 CycloneDDS 참여자 인덱스 고갈로 노드 25개 즉사)
  docker run -d --name "$PSIM" --network host --gpus all --cap-add=NET_ADMIN \
    "${COMMON[@]}" \
    -e DISPLAY="${DISPLAY:-:0}" -e QT_X11_NO_MITSHM=1 -v /tmp/.X11-unix:/tmp/.X11-unix:rw \
    -v "$(dirname "$(dirname "$MAP_HOST")")":/autoware_data:ro \
    "$IMAGE" bash -c "$SRC
      ros2 launch autoware_launch planning_simulator.launch.xml \
        map_path:=/autoware_data/maps/$(basename "$MAP_HOST") \
        vehicle_model:=$VEHICLE sensor_model:=$SENSOR vehicle_id:=$VEHICLE rviz:=$rviz $extra" >/dev/null
  printf "${B}psim up${N} vehicle_model=%s sensor_model=%s map=%s rviz=%s %s\n" "$VEHICLE" "$SENSOR" "$(basename "$MAP_HOST")" "$rviz" "$extra"
  local i=0
  while [ $i -lt 40 ]; do
    sleep 2; i=$((i+1))
    running || { bad "컨테이너 종료됨" "rover psim logs -f 로 확인"; return 1; }
    if docker logs "$PSIM" 2>&1 | grep -q "\[rviz2-[0-9]*\]: process started\|rviz2.*Stereo is\|simple_planning_simulator.*process started"; then break; fi
  done
  sleep 8
  local died; died="$(docker logs "$PSIM" 2>&1 | { grep -o '\[ERROR\] \[[^]]*\]: process has died' || true; } | sort -u | wc -l)"  # grep 무결과(=정상)가 pipefail 로 스크립트를 죽이지 않게
  if [ "$died" = 0 ]; then ok "노드 전부 생존" "$(docker exec "$PSIM" bash -c "$SRC; ros2 node list 2>/dev/null | wc -l") 노드"
  else bad "죽은 프로세스 ${died}종" "rover psim logs"; fi
  echo "  다음: RViz 2D Pose Estimate → 2D Goal Pose(같은 차선·진행 방향) → AUTO"
}
psim_down() { exists && { docker rm -f "$PSIM" >/dev/null; ok "psim 종료"; } || printf "  ${D}·${N} psim 미실행\n"; }
psim_logs() {
  exists || die "psim 미실행"
  if [ "${1:-}" = -f ]; then docker logs -f "$PSIM"; return; fi
  docker logs "$PSIM" 2>&1 | grep -n "\[ERROR\]\|process has died\|Failed to plan\|Failed to find a proper route\|start lane ids\|goal lane id\|Setting goal pose\|Setting estimate pose" \
    | grep -v "Mode path not found\|has not received. Set ERROR\|VehicleCmdFilter" | cut -c1-200 | tail -40 || true
}
psim_check() {
  running || die "psim 미실행"
  docker exec "$PSIM" bash -c "$SRC
    echo '--- robot_description 패키지 경로:'; ros2 param get /robot_state_publisher robot_description 2>/dev/null | grep -o 'package://[a-z_0-9]*/' | sort -u | sed 's/^/  /'
    echo '--- 차량 mesh:'; ros2 param get /robot_state_publisher robot_description 2>/dev/null | grep -o 'package://rtst_rover_description/[^\\\"]*' | sed 's/^/  /'
    echo '--- TF base_link → 센서 (xyz):'
    for f in sensor_kit_base_link lidar_frame imu_link camera_link rs_helios_top; do
      printf '  %-22s ' \$f; timeout 4 ros2 run tf2_ros tf2_echo base_link \$f 2>&1 | grep -m1 Translation || echo '(없음)'; done
    echo '--- simple_planning_simulator 가 받은 값:'
    for p in vehicle_model_type wheel_base wheel_tread max_steer_angle vel_lim steer_lim acc_time_delay steer_time_delay; do
      printf '  %-18s ' \$p; ros2 param get /simulation/simple_planning_simulator \$p 2>/dev/null | sed 's/.*value is: //' || echo '?'; done
    echo '--- 플래닝 (autoware_planning_config/config/scenario_planning/common/common.param.yaml → velocity_smoother):'
    printf '  config 패키지 출처  '; ros2 pkg prefix autoware_planning_config 2>/dev/null | sed 's|/opt/autoware/.*|& (이미지 사본 — fork yaml 미반영)|; s|/ws/install/.*|& (우리 오버레이 — fork yaml 반영)|'
    for p in max_vel normal.max_acc normal.min_acc normal.max_jerk; do
      printf '  %-18s ' \$p; ros2 param get /planning/scenario_planning/velocity_smoother \$p 2>/dev/null | sed 's/.*value is: //' || echo '?'; done
    echo '--- 상태:'
    printf '  노드 수 '; ros2 node list 2>/dev/null | wc -l
    printf '  scenario '; timeout 3 ros2 topic echo /planning/scenario_planning/scenario --once --field current_scenario 2>/dev/null | head -1 || echo '?'
    printf '  routing  state='; timeout 3 ros2 topic echo /api/routing/state --once --field state 2>/dev/null | head -1 | tr -d '\n'; echo '  (1 UNSET, 2 SET, 3 ARRIVED, 4 CHANGING)'
    printf '  op mode  '; timeout 3 ros2 topic echo /api/operation_mode/state --once 2>/dev/null | grep -E '^mode|is_autonomous_mode_available' | paste -sd' ' || echo '?'
    printf '  ego xy   '; timeout 3 ros2 topic echo /localization/kinematic_state --once --field pose.pose.position 2>/dev/null | head -2 | paste -sd' ' || echo '(초기 위치 전)'
  " 2>&1 | grep -v '^\[entrypoint\]'
}
cmd_psim() {
  case "${1:-}" in
    up) shift; psim_up "$@";; down) psim_down;; restart) psim_down; shift; psim_up "$@";;
    logs) shift; psim_logs "$@";; check) psim_check;;
    goal|pose|auto) die "psim $1: 아직 없음 (RViz 없이 초기위치·goal·AUTO — 회귀 테스트 때 추가)";;
    *) die "rover psim up|down|restart|logs [-f]|check";;
  esac
}
cmd_shell() { running || die "psim 미실행 — rover psim up"; docker exec -it "$PSIM" bash -c "$SRC; exec bash"; }

case "${1:-}" in
  build) shift; cmd_build "$@";;
  psim)  shift; cmd_psim "$@";;
  shell) cmd_shell;;
  carla|real|dds) die "rover $1: 아직 없음 ($1 = $( [ "$1" = carla ] && echo ST-2 || echo 실차 ) 때 채움)";;
  *) sed -n '2,10p' "$0";;
esac
