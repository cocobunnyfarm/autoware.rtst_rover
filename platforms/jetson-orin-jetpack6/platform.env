# 플랫폼: Jetson Orin 계열 + JetPack 6 (Jetson Linux R36.x) — 값만 둔다. 동작은 fetch.sh · build.sh · tools/rover.
# 왜 이 값들인지와 실측 기록은 같은 폴더 README.md.
# shellcheck shell=bash disable=SC2034

PLATFORM_NAME=jetson-orin-jetpack6

# --- 이 플랫폼인지 판정 (platforms/detect.sh 가 읽는다) ---
PLATFORM_MATCH_SOC=tegra234                 # /proc/device-tree/compatible 에 들어 있어야 하는 값 (Orin 계열)
PLATFORM_MATCH_L4T_MAJOR=36                 # /etc/nv_tegra_release 의 "# R36" (JetPack 6)

# --- 이미지: Autoware 릴리스는 repositories/rtst_rover.pin 이 정하고, 여기서는 종류만 ---
PLATFORM_IMAGE_KIND=universe-cuda           # → ghcr.io/autowarefoundation/autoware:universe-cuda-jazzy-<UPSTREAM_TAG> (arm64)

# --- 받아서 얹는 것: NVIDIA apt 저장소의 deb 를 풀어 컨테이너에 마운트한다 (호스트에 설치하지 않는다) ---
PLATFORM_APT_REPO=https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2404/sbsa
PLATFORM_TRT_VERSION=10.16.1                # Orin(sm_87) 코드가 들어 있는 첫 계열. 이미지 기본 10.13.3 에는 없다
PLATFORM_CUDA_COMPAT_VERSION=13.2           # 호스트 드라이버 12.6 위에서 이미지의 CUDA 13.0 런타임을 돌린다

# "sha256  파일이름" — 한 줄에 하나. fetch.sh 가 받은 뒤 대조한다.
PLATFORM_DEBS_RUNTIME="
bec8a8981b18e118f99fb2fca0eaab759e1f59e5833132e71f43656af544976d  cuda-compat-orin-13-2_13.2.44429113-1_arm64.deb
2532bb3d28fa746602f019e21e60a36342241eccd06abb0c3484ee54cf83241e  libnvinfer10_10.16.1.11-1+cuda13.2_arm64.deb
80539d8bece86ddefeeae92ef826f9ec22f02840586d7950cac6e1d4cabf4675  libnvinfer-plugin10_10.16.1.11-1+cuda13.2_arm64.deb
f891b161b85ae2e1df831473fd9102f290ced2c7998ce5d5983f989f4da27422  libnvonnxparsers10_10.16.1.11-1+cuda13.2_arm64.deb
"
# 다시 빌드할 때만 필요한 헤더
PLATFORM_DEBS_BUILD="
e266965c3144e3fd8d1969cf9e97dc685f03914c6a97436ff43b9f184415abc4  libnvinfer-headers-dev_10.16.1.11-1+cuda13.2_arm64.deb
3765650df42ca248f3f3095f774c53cf4154a35bb9edc2089e277a11a8dbc3d0  libnvinfer-headers-plugin-dev_10.16.1.11-1+cuda13.2_arm64.deb
1f2fb08570705fbf539d2f3fdefc616922f598f57474ed8a32ce7e76de228352  libnvonnxparsers-dev_10.16.1.11-1+cuda13.2_arm64.deb
"

# --- 받은 것을 두는 곳 (git 밖) ---
#   호스트: $PLATFORM_HOST_DIR   컨테이너: $PLATFORM_MOUNT
PLATFORM_HOST_DIR="${ROVER_PLATFORM_DIR:-$HOME/autoware_data/platforms/$PLATFORM_NAME}"
PLATFORM_MOUNT=/opt/rover_platform

# --- 컨테이너 안 라이브러리 경로: 이 순서로 이미지 기본값 앞에 붙인다 ---
#   1) 호환 드라이버(libcuda.so 13.2)  2) TensorRT 10.16.1  3) 호스트 드라이버 라이브러리(L4T 가 마운트)
PLATFORM_LD_PREPEND="$PLATFORM_MOUNT/root/usr/local/cuda-13.2/compat_orin:$PLATFORM_MOUNT/root/usr/lib/aarch64-linux-gnu:/usr/lib/aarch64-linux-gnu/nvidia"

# --- 컨테이너를 GPU 로 띄우는 옵션 (Tegra 에서는 --gpus all 이 아니다) ---
PLATFORM_DOCKER_GPU_ARGS="--runtime nvidia -e NVIDIA_VISIBLE_DEVICES=all -e NVIDIA_DRIVER_CAPABILITIES=all"

# --- 다시 빌드해 오버레이하는 Autoware 패키지 ---
#   이유: 엔진 캐시 검사가 컴파일 때의 TensorRT 버전 상수를 쓴다 → 얹은 TensorRT 와 같은 헤더로 다시 빌드해야 엔진을 재사용한다.
PLATFORM_REBUILD_PKGS="tensorrt_cmake_module autoware_tensorrt_common"
PLATFORM_REBUILD_UNIVERSE_PATHS="perception/autoware_tensorrt_common"     # autoware_universe 에서 받을 폴더 (버전은 autoware.repos 의 universe 버전)
PLATFORM_TRT_CMAKE_MODULE_URL=https://github.com/tier4/tensorrt_cmake_module
PLATFORM_TRT_CMAKE_MODULE_TAG=0.0.5
PLATFORM_TRT_CMAKE_MODULE_COMMIT=c93843021db6e0006c1857dd8f4e0f66e9b42bc1
